# Arceus environment example.
# Copy this to .env when implementation begins and fill in real values locally.

ARCEUS_ENV=local
ARCEUS_OWNER_ID=local-user
ARCEUS_WORKER_ROLE=laptop-primary

# Later: local or cloud Postgres connection string.
DATABASE_URL=postgresql://arceus:arceus@localhost:5432/arceus

# Runtime mode. Supported now: "offline", "codex_manual".
# Later values may include "codex_app_server" and "claude_code".
ARCEUS_RUNTIME_MODE=offline

# Local Codex runtime. This path is used for status checks and future app-server work.
ARCEUS_CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
ARCEUS_CODEX_SANDBOX=workspace-write
ARCEUS_CODEX_APPROVAL_POLICY=never
ARCEUS_CODEX_SKIP_GIT_REPO_CHECK=false
ARCEUS_CODEX_TIMEOUT_SECONDS=1800

# Later: optional knowledge-base integrations.
OBSIDIAN_VAULT_PATH=
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=
